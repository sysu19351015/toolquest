{
  "name": "toolquest-mcp",
  "version": "0.5.0",
  "description": "A deterministic MCP evaluation environment and live observation console for tool-using agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "toolquest-mcp": "./dist/server.js",
    "toolquest-web": "./dist/web/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "web",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build --silent && vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "start:web": "node dist/web/server.js",
    "start:playground": "node dist/web/server.js --playground",
    "web": "npm run build --silent && node dist/web/server.js",
    "playground": "npm run build --silent && node dist/web/server.js --playground",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "agent",
    "benchmark",
    "mcp",
    "model-context-protocol",
    "tool-calling"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
